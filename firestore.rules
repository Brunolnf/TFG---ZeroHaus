rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión iniciada aunque el email aún no esté verificado. Solo se usa para
    // lo imprescindible antes de verificar: crear/leer tu propio perfil y ajustes.
    function autenticado() { return request.auth != null; }
    // Sesión con el email verificado (código de 6 dígitos): requisito para
    // todo lo demás. Así, aunque alguien modifique la app, sin verificar no
    // puede leer ni escribir nada.
    function logueado() {
      return autenticado() && request.auth.token.email_verified == true;
    }
    function esMio(uid) { return logueado() && request.auth.uid == uid; }
    function esMioSinVerificar(uid) { return autenticado() && request.auth.uid == uid; }
    function uid()      { return request.auth.uid; }
    function noMuta(campo) {
      return campo in request.resource.data.keys()
          && request.resource.data[campo] == resource.data[campo];
    }
    function noMutaOpcional(campo) {
      return (!(campo in resource.data.keys())
              && !(campo in request.resource.data.keys()))
          || (campo in resource.data.keys()
              && campo in request.resource.data.keys()
              && request.resource.data[campo] == resource.data[campo]);
    }
    function esAdmin() {
      return logueado()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }
    function tipoUsuarioDe(u) {
      return get(/databases/$(database)/documents/usuarios/$(u)).data.tipoUsuario;
    }
    function tamanoDocMaximo() {
      return request.resource.data.keys().size() <= 40;
    }
    // Límites de los campos editables del perfil profesional
    function camposPerfilValidos() {
      let d = request.resource.data;
      return (!('nombre' in d.keys()) || (d.nombre is string && d.nombre.size() <= 100))
          && (!('descripcion' in d.keys()) || (d.descripcion is string && d.descripcion.size() <= 2000))
          && (!('telefono' in d.keys()) || (d.telefono is string && d.telefono.size() <= 20))
          && (!('emailContacto' in d.keys()) || (d.emailContacto is string && d.emailContacto.size() <= 254));
    }
    // El perfil profesional lo descarga todo el mundo (directorio y mapa): sin
    // estos límites un profesional podía meter campos inventados o enormes y
    // hacer que cada cliente se bajara ~1 MB por él. `claves` son los campos
    // que se escriben (todos al crear, solo los cambiados al editar), para no
    // bloquear perfiles antiguos por campos que no se tocan.
    function especialidadValida(l, i) {
      return l.size() <= i || (l[i] is string && l[i].size() <= 80);
    }
    function especialidadesValidas(l) {
      return l is list && l.size() <= 20
          && especialidadValida(l, 0) && especialidadValida(l, 1) && especialidadValida(l, 2)
          && especialidadValida(l, 3) && especialidadValida(l, 4) && especialidadValida(l, 5)
          && especialidadValida(l, 6) && especialidadValida(l, 7) && especialidadValida(l, 8)
          && especialidadValida(l, 9) && especialidadValida(l, 10) && especialidadValida(l, 11)
          && especialidadValida(l, 12) && especialidadValida(l, 13) && especialidadValida(l, 14)
          && especialidadValida(l, 15) && especialidadValida(l, 16) && especialidadValida(l, 17)
          && especialidadValida(l, 18) && especialidadValida(l, 19);
    }
    function camposUbicacionValidos(claves) {
      let d = request.resource.data;
      return (!('ciudad' in claves) || (d.ciudad is string && d.ciudad.size() <= 100))
          && (!('especialidades' in claves) || especialidadesValidas(d.especialidades))
          && (!('latitud' in claves) || (d.latitud is number && d.latitud >= -90 && d.latitud <= 90))
          && (!('longitud' in claves) || (d.longitud is number && d.longitud >= -180 && d.longitud <= 180));
    }
    // Al editar solo cambian campos del modelo Tecnico de la app (los de
    // servidor siguen congelados con noMuta); nada de campos nuevos.
    function edicionPerfilValida() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return camposPerfilValidos()
          && camposUbicacionValidos(cambios)
          && cambios.hasOnly(['id', 'uid', 'nombre', 'ciudad', 'descripcion', 'telefono',
                              'emailContacto', 'especialidades', 'latitud', 'longitud',
                              'distanciaKm', 'tipoProfesional', 'rating', 'opiniones',
                              'proyectosCompletados', 'planActivo', 'suscripcionHasta']);
    }
    // Ids de chat como los que crea la app (automáticos de Firestore). El id
    // se mete en la expresión que valida los adjuntos: con «x|.*» aceptaba
    // un enlace a cualquier web.
    function idChatValido(chatId) {
      return chatId.matches('[A-Za-z0-9_-]{1,128}');
    }

    match /usuarios/{userId} {
      // Leer y crear tu propio perfil se permite antes de verificar: el registro
      // lo crea justo después de crear la cuenta y el login comprueba bloqueos.
      allow read: if esMioSinVerificar(userId) || esAdmin();
      allow create: if (esMioSinVerificar(userId)
                    && tamanoDocMaximo()
                    && request.resource.data.uid == userId
                    && request.resource.data.tipoUsuario in ['Propietario', 'Técnico', 'Empresa']
                    && request.resource.data.bloqueado == false
                    && request.resource.data.eliminado == false
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 60
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254)
                    || esAdmin();
      allow update: if esAdmin()
                    || (esMio(userId)
                        && tamanoDocMaximo()
                        && noMuta('uid')
                        && noMuta('email')
                        && noMuta('tipoUsuario')
                        && noMuta('fechaRegistro')
                        && noMuta('bloqueado')
                        && noMuta('eliminado')
                        && (!('nombre' in request.resource.data.keys())
                            || (request.resource.data.nombre is string
                                && request.resource.data.nombre.size() <= 60)));
      // Solo el administrador: borrarlo y volver a crearlo quitaba el bloqueo.
      // El borrado de la propia cuenta lo hace la Cloud Function eliminar_mi_cuenta.
      allow delete: if esAdmin();
    }

    match /viviendas/{docId} {
      allow read:   if (logueado() && resource.data.uid == uid()) || esAdmin();
      allow create: if (logueado()
                    && tamanoDocMaximo()
                    && request.resource.data.uid == uid()
                    && request.resource.data.keys().hasAll(['uid', 'nombre'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 100)
                    || esAdmin();
      allow update: if (logueado() && resource.data.uid == uid()
                    && tamanoDocMaximo()
                    && noMuta('uid'))
                    || esAdmin();
      allow delete: if (logueado() && resource.data.uid == uid()) || esAdmin();
    }

    match /informes/{docId} {
      allow read:   if (logueado() && resource.data.uid == uid()) || esAdmin();
      allow create: if (logueado()
                    && tamanoDocMaximo()
                    && request.resource.data.uid == uid())
                    || esAdmin();
      allow update: if (logueado() && resource.data.uid == uid()
                    && tamanoDocMaximo()
                    && noMuta('uid'))
                    || esAdmin();
      allow delete: if (logueado() && resource.data.uid == uid()) || esAdmin();
    }

    match /tecnicos/{docId} {
      allow read:   if logueado();
      // El perfil profesional también se crea en el registro, antes de verificar
      allow create: if (autenticado()
                    && tamanoDocMaximo()
                    && docId == uid()
                    && request.resource.data.uid == uid()
                    && tipoUsuarioDe(uid()) in ['Técnico', 'Empresa']
                    && request.resource.data.tipoProfesional in ['TECNICO', 'EMPRESA']
                    && (request.resource.data.tipoProfesional == 'EMPRESA')
                        == (tipoUsuarioDe(uid()) == 'Empresa')
                    && request.resource.data.rating == 0
                    && request.resource.data.opiniones == 0
                    && request.resource.data.proyectosCompletados == 0
                    // El plan solo lo concede la Cloud Function de suscripciones:
                    // sin esto se podía crear el perfil ya con un plan "eterno"
                    && request.resource.data.get('planActivo', '') == ''
                    && request.resource.data.get('suscripcionHasta', 0) == 0
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 100
                    && camposPerfilValidos()
                    && camposUbicacionValidos(request.resource.data.keys()))
                    || esAdmin();
      allow update: if esAdmin()
                    || ((logueado() && resource.data.uid == uid() && noMuta('uid'))
                        && tamanoDocMaximo()
                        && noMuta('rating') && noMuta('opiniones') && noMuta('proyectosCompletados')
                        && noMutaOpcional('planActivo') && noMutaOpcional('suscripcionHasta')
                        && noMutaOpcional('tipoProfesional')
                        && edicionPerfilValida())
                    || ((logueado() && docId == uid() && request.resource.data.uid == uid())
                        && tamanoDocMaximo()
                        && noMuta('rating') && noMuta('opiniones') && noMuta('proyectosCompletados')
                        && noMutaOpcional('planActivo') && noMutaOpcional('suscripcionHasta')
                        && noMutaOpcional('tipoProfesional')
                        && edicionPerfilValida())
                    // Reclamar un perfil legacy sin uid: solo con el email VERIFICADO
                    // (si no, cualquiera podría registrarse con el correo de otro).
                    || ((logueado()
                        && request.auth.token.email_verified == true
                        && resource.data.emailContacto == request.auth.token.email
                        && (resource.data.uid == '' || resource.data.uid == null)
                        && request.resource.data.uid == uid())
                        && tamanoDocMaximo()
                        && noMuta('rating') && noMuta('opiniones') && noMuta('proyectosCompletados')
                        && noMutaOpcional('planActivo') && noMutaOpcional('suscripcionHasta')
                        && noMutaOpcional('tipoProfesional')
                        && edicionPerfilValida());
      allow delete: if esAdmin();

      // Eventos para las estadísticas del profesional (visita al perfil,
      // contacto por chat o llamada). Como mucho uno por cliente, día (UTC) y
      // tipo gracias al id determinista; el día lo fija el reloj del servidor,
      // así que no se pueden inventar fechas. Nadie los lee desde la app: la
      // Cloud Function los agrega en /estadisticas y los borra a las 48 h.
      match /eventos/{eventoId} {
        allow create: if logueado()
          && request.resource.data.keys().hasOnly(['dia', 'tipo'])
          && request.resource.data.tipo in ['visita', 'chat', 'llamada']
          && request.resource.data.dia == request.time.year() * 10000
                                          + request.time.month() * 100
                                          + request.time.day()
          && eventoId == uid() + '_' + string(request.resource.data.dia) + '_' + request.resource.data.tipo
          && docId != uid()
          && get(/databases/$(database)/documents/tecnicos/$(docId)).data.uid != uid();
        allow read, update, delete: if esAdmin();
      }
    }

    // Agregados de estadísticas: solo los escribe la Cloud Function.
    match /estadisticas/{tecnicoId} {
      allow read: if (logueado()
                      && (tecnicoId == uid()
                          || get(/databases/$(database)/documents/tecnicos/$(tecnicoId)).data.uid == uid()))
                  || esAdmin();
      allow write: if false;
    }

    match /suscripciones/{token} {
      allow read: if (logueado() && resource.data.uid == uid()) || esAdmin();
      allow write: if false;
    }

    match /notificaciones/{docId} {
      allow read, delete: if (logueado() && resource.data.uid == uid()) || esAdmin();
      // Solo marcarla como leída: cambiar el uid la colaría en la lista de otro
      allow update: if (logueado() && resource.data.uid == uid()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
                    && request.resource.data.leida is bool)
                    || esAdmin();
      // Las crean las Cloud Functions; la app ya no crea ninguna
      allow create: if esAdmin();
    }

    // Solo se puede valorar a un profesional con quien existe una conversación
    // real: los dos han escrito en el chat, o sea, el profesional ha
    // contestado. `escribieron` solo lo pone la Cloud Function de mensajes
    // (antes bastaba con abrir un chat o escribirle uno mismo).
    function conversacionReal(chatId, tecnicoId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      let prof = get(/databases/$(database)/documents/tecnicos/$(tecnicoId)).data;
      return uid() in chat.participantes
          && prof.uid in chat.participantes
          && uid() in chat.get('escribieron', [])
          && prof.uid in chat.get('escribieron', []);
    }

    match /resenas/{docId} {
      allow read: if logueado();
      allow create: if (logueado()
                    && tamanoDocMaximo()
                    && request.resource.data.uid == uid()
                    && request.resource.data.tecnicoId is string
                    && request.resource.data.tecnicoId.size() > 0
                    && request.resource.data.tecnicoId.size() <= 128
                    && request.resource.data.tecnicoId != uid()
                    && docId == uid() + '_' + request.resource.data.tecnicoId
                    && request.resource.data.chatId is string
                    && conversacionReal(request.resource.data.chatId, request.resource.data.tecnicoId)
                    && request.resource.data.puntuacion is number
                    && request.resource.data.puntuacion >= 1
                    && request.resource.data.puntuacion <= 5
                    && request.resource.data.puntuacion == int(request.resource.data.puntuacion)
                    && (!('comentario' in request.resource.data.keys())
                        || (request.resource.data.comentario is string
                            && request.resource.data.comentario.size() <= 1000)))
                    || esAdmin();
      allow update: if esAdmin()
                    || (logueado()
                        && tamanoDocMaximo()
                        && resource.data.uid == uid()
                        && noMuta('uid')
                        && noMuta('tecnicoId')
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['puntuacion', 'comentario', 'fecha', 'nombreUsuario', 'chatId', 'id'])
                        && request.resource.data.puntuacion is number
                        && request.resource.data.puntuacion >= 1
                        && request.resource.data.puntuacion <= 5
                        && request.resource.data.puntuacion == int(request.resource.data.puntuacion)
                        && (!('comentario' in request.resource.data.keys())
                            || (request.resource.data.comentario is string
                                && request.resource.data.comentario.size() <= 1000)));
      allow delete: if (logueado() && resource.data.uid == uid()) || esAdmin();
    }

    // Un chat nuevo nace vacío, entre dos personas distintas y con los nombres
    // solo de sus participantes (antes se podía crear ya "con mensajes", que es
    // lo que exigen las reseñas).
    function chatNuevoValido(chatId) {
      let d = request.resource.data;
      return idChatValido(chatId)
          && d.participantes is list
          && d.participantes.size() == 2
          && uid() in d.participantes
          && d.participantes[0] != d.participantes[1]
          && (!('nombresParticipantes' in d) || d.nombresParticipantes.keys().hasOnly(d.participantes))
          && d.get('fechaUltimoMensaje', 0) == 0
          && d.get('ultimoMensaje', '') == ''
          && d.get('escribieron', []).size() == 0;
    }
    // Al enviar o leer un mensaje solo cambian el último mensaje, su fecha y
    // los no leídos. Antes un participante podía cambiar cualquier campo,
    // por ejemplo el nombre con el que el otro le ve.
    function cambioDeChatValido() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['ultimoMensaje', 'fechaUltimoMensaje', 'noLeidosPor'])
          && d.get('ultimoMensaje', '') is string
          && d.get('ultimoMensaje', '').size() <= 2100
          && d.get('fechaUltimoMensaje', 0) is int
          && d.get('fechaUltimoMensaje', 0) <= request.time.toMillis() + 86400000
          && d.get('noLeidosPor', {}).keys().hasOnly(resource.data.participantes);
    }
    // Mensaje bien formado. Los adjuntos solo pueden apuntar al Storage de
    // este mismo chat: antes se podía mandar como «foto» o «archivo» un
    // enlace a cualquier web, que el otro abría.
    function mensajeValido(chatId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'chatId', 'emisorUid', 'emisorNombre', 'texto', 'fecha',
                               'leido', 'tipo', 'mediaUrl', 'mediaNombre', 'mediaBytes'])
          && d.emisorUid == uid()
          && d.get('tipo', 'texto') in ['texto', 'imagen', 'archivo']
          && d.get('texto', '') is string && d.get('texto', '').size() <= 2000
          && d.get('emisorNombre', '') is string && d.get('emisorNombre', '').size() <= 100
          && d.get('mediaNombre', '') is string && d.get('mediaNombre', '').size() <= 255
          // Los archivos son solo PDF (las fotos van como «imagen»): antes se
          // podía mandar cualquier cosa, también una APK
          && (d.get('tipo', 'texto') != 'archivo' || d.get('mediaNombre', '').lower().matches('.+[.]pdf'))
          && (d.get('mediaUrl', '') == ''
              || (d.get('tipo', 'texto') != 'texto'
                  && idChatValido(chatId)
                  && d.mediaUrl is string
                  && d.mediaUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/zerohaus-2a865[.]firebasestorage[.]app/o/chats%2F'
                                        + chatId + '%2F[^/]+')));
    }

    match /chats/{chatId} {
      allow read: if (logueado() && uid() in resource.data.participantes) || esAdmin();
      // La app no borra chats (borrarlo dejaba sus mensajes huérfanos)
      allow delete: if esAdmin();
      allow create: if (logueado() && tamanoDocMaximo() && chatNuevoValido(chatId)) || esAdmin();
      allow update: if (logueado() && uid() in resource.data.participantes
                    && tamanoDocMaximo()
                    && cambioDeChatValido())
                    || esAdmin();

      match /mensajes/{mensajeId} {
        allow read: if (logueado() &&
          uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes)
          || esAdmin();
        allow create: if (logueado()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes
          && mensajeValido(chatId))
          || esAdmin();
        // Sin edición: permitía cambiar emisorUid y atribuir el mensaje al otro
        // participante. El emisor puede borrarlo.
        allow update: if esAdmin();
        allow delete: if (logueado() && resource.data.emisorUid == uid()) || esAdmin();
      }
    }

    // Ajustes propios (idioma, tema, token de notificaciones) también antes de
    // verificar: el token FCM se registra en cuanto hay sesión.
    match /ajustes/{userId} {
      allow read, delete: if esMioSinVerificar(userId) || esAdmin();
      allow create, update: if (esMioSinVerificar(userId) && tamanoDocMaximo()) || esAdmin();
    }

    // /verificaciones_email (huellas de los códigos) y /limites_ia: solo las
    // Cloud Functions con Admin SDK. Caen en el deny-all de abajo.

    // La feature de certificados está eliminada: no se define regla, así que
    // cae en el deny-all de abajo. NO abrir esta colección sin schema real.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
