rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Igual que en Firestore: sin el email verificado (código de 6 dígitos)
    // no se puede leer ni subir nada.
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Tipos de imagen admitidos (la app sube siempre JPEG). Lista cerrada: el
    // tipo lo declara el cliente y con «image/.*» entraban SVG con scripts.
    function imagenPermitida() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Imágenes y archivos del chat — solo participantes del chat
    // Usamos cross-service rules para consultar la membresía en Firestore.
    match /chats/{chatId}/{archivo=**} {
      allow read: if verificado()
                  && request.auth.uid in firestore.get(
                       /databases/(default)/documents/chats/$(chatId)
                     ).data.participantes;
      // Solo archivos nuevos: cada envío usa un nombre nuevo (el id del
      // mensaje). Sobrescribir o borrar permitía a un participante cambiar o
      // quitar lo que había enviado el otro. El borrado de cuentas y chats lo
      // hace el servidor con el Admin SDK.
      // (subir encima de un archivo existente también cuenta como create)
      // Solo fotos y PDF: antes valía cualquier archivo (también una APK)
      allow create: if verificado()
                    && resource == null
                    && request.auth.uid in firestore.get(
                         /databases/(default)/documents/chats/$(chatId)
                       ).data.participantes
                    && request.resource.size < 15 * 1024 * 1024
                    && (imagenPermitida()
                        || (request.resource.contentType == 'application/pdf'
                            && request.resource.name.lower().matches('.+[.]pdf')));
      allow update, delete: if false;
    }

    // Fotos de perfil — lectura por usuarios verificados. El dueño puede
    // borrar lo suyo (antes la regla de escritura lo impedía porque exigía
    // un archivo nuevo con tipo y tamaño).
    match /perfiles/{uid}/{archivo=**} {
      allow read:   if verificado();
      allow delete: if verificado() && request.auth.uid == uid;
    }

    // Subir o cambiar la foto solo con el nombre que usa la app: una foto por
    // usuario, de hasta 5 MB, en vez de archivos sin límite en su carpeta.
    match /perfiles/{uid}/foto_perfil {
      allow create, update: if verificado() && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && imagenPermitida();
    }

    // Cualquier otra ruta (incluidos los certificados de la función ya
    // eliminada) queda denegada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
