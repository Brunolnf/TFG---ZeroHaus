<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo ZeroHaus para adaptive icon (Android 8+).
  Coordenadas en viewport 108×108. La forma se mantiene dentro de la safe
  zone (66dp central) para que no se recorte con máscaras circulares o
  squircle de distintos launchers.

  Background: verde #16A34A (definido en ic_launcher_background.xml).
  Foreground: casa blanca con hoja interior verde claro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Silueta de la casa: tejado a dos aguas + cuerpo + esquinas inferiores redondeadas, una sola forma cerrada -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,17
                          L87,47
                          L87,83
                          Q87,90 80,90
                          L28,90
                          Q21,90 21,83
                          L21,47 Z" />

    <!-- Hoja botánica con doble punta, centrada como puerta -->
    <path
        android:fillColor="#86EFAC"
        android:pathData="M54,51
                          C80,60 80,80 54,87
                          C28,80 28,60 54,51 Z" />

    <!-- Nervadura central de la hoja, un solo trazo limpio -->
    <path
        android:strokeColor="#16A34A"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M54,54 Q53,70 54,85" />
</vector>
