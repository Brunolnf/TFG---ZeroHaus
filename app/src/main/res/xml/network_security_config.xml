<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — seguridad de red.
  1. Prohíbe tráfico cleartext (HTTP) en toda la app.
  2. Solo confía en certificados del sistema (no en los que instale el
     usuario): un certificado añadido a mano en el móvil (Burp, mitmproxy,
     Charles…) no sirve para interceptar el tráfico de la app.

  Sin certificate pinning a propósito: solo se fijaban 3 raíces de Google
  (GTS R1, GTS R2 y GlobalSign R2) y Google sirve también cadenas de otras
  raíces (GTS R3/R4) y las rota sin aviso; con una de ellas la app dejaba de
  conectar con Firebase. Google desaconseja fijar sus certificados.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
